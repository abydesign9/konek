# --- Core ---
DATABASE_URL=postgres://...        # Supabase connection string
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change_me
PII_MASTER_KEY=change_me            # base64 of 32 random bytes: openssl rand -base64 32 (encrypts KYC/PII at rest)
# --- Email (Resend) — all OTP is emailed for now ---
RESEND_API_KEY=            # re_... from resend.com (unset = OTP codes returned in dev responses)
RESEND_FROM=Konek <no-reply@yourdomain.com>   # verified sender; omit to use Resend's shared test sender
# --- OTP / SMS (phone OTP; SMS provider wired later) ---
TERMII_API_KEY=
# --- Payments ---
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_WEBHOOK_SECRET=
# --- VTU aggregators (adapter ids: reloadly, vtu_ng) ---
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
VTU_NG_API_KEY=
# --- eSIM (eSIM Access / RedTea) — https://api.esimaccess.com ---
# Adapter registers itself only when ESIM_ACCESS_ACCESS_CODE is set; without it
# eSIM falls back to the mock provider.
ESIM_ACCESS_ACCESS_CODE=
ESIM_ACCESS_SECRET_KEY=
ESIM_ACCESS_BASE_URL=https://api.esimaccess.com
ESIM_ACCESS_SIGN=false        # true = send HMAC-SHA256 RT-Signature headers (only if your account requires it)
ESIM_PARTNER_API_KEY=
# --- KYC ---
DOJAH_APP_ID=
DOJAH_SECRET=
# --- Ops ---
ADMIN_ALLOWLIST_EMAILS=you@example.com
CRON_SECRET=change_me
ADMIN_SECRET=change_me
# --- Phase 2: dollar accounts (Fincra/Cadana/Sudo) ---
FINCRA_WEBHOOK_SECRET=change_me

# --- Private KYC document storage ---
# Development default: .data/kyc-documents
# Production must use a persistent private storage location.
KYC_DOCUMENT_STORAGE_DIR=

# --- Web Push (generate with: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com
