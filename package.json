{
  "name": "konek",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "node -r dotenv/config scripts/migrate.mjs dotenv_config_path=.env.local",
    "test": "vitest run",
    "reconcile": "node -r dotenv/config scripts/reconcile.mjs dotenv_config_path=.env.local",
    "cron:dev": "node -r dotenv/config scripts/cron_dev.mjs dotenv_config_path=.env.local",
    "sync": "bash scripts/sync.sh",
    "update": "git pull --rebase origin $(git rev-parse --abbrev-ref HEAD) && npm install && npm run db:migrate",
    "check": "npx tsc --noEmit && next lint && vitest run --exclude \"**/*.integration.test.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "next": "14.2.35",
    "next-pwa": "^5.6.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
